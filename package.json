{
  "name": "klassen-status",
  "productName": "Klassen-Status",
  "version": "1.0.0",
  "description": "Status-App für die Klasse: wer ist frei, wer hat eine Frage – mit Hilfe-Knopf an den Admin.",
  "main": "main.js",
  "author": "Klasse",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "relay": "node relay/relay.js"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ch.klasse.klassenstatus",
    "productName": "Klassen-Status",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "maintainer": "Klasse"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": null,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "desktopName": "klassen-status.desktop",
  "private": true
}
